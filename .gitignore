# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/

# OS / editors
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# Backups + audit folders (created by cleanup operations)
_backup_*/
_backup_silent_*/
_backup_final_*/
_silent_audit_*/
instruments/*/_backup_*/

# Build outputs / large binary artifacts
releases/*.zip
*.adv.bak
_meter_previews/

# Bench runtime state
log.json
session.json
clock_state.json

# Temp + cache
/tmp/
*.tmp
*.log
.cache/

# WAV captures live on external storage (T7) — symlinks back into the project.
# Never commit raw audio to git: bloats the repo + bad for public clone speed.
instruments/*/patches/
instruments/*/one-shots/
instruments/*/loops/
*.wav
*.aif
*.flac

# Pack releases are built artifacts — don't commit; ship via GitHub Releases instead
releases/spacepit-*/
tools/dashboard/capture-log.json
releases/compositions/
